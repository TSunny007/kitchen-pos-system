# Every environment variable this app reads, with its default.
#
# Copy to .env.local to run against a single project:
#     cp .env.example .env.local
#
# Only the two SUPABASE lines are required — everything else has a working
# default, so the app boots with just those filled in. The branding and locale
# variables are resolved in app/config/tenant.ts and read nowhere else; the
# Supabase credentials are read by app/lib/supabase/client.ts.
#
# If you keep separate sandbox and production projects, copy to .env.sandbox
# and .env.prod instead and drive them with the Makefile (`make dev-sandbox`).
# All of these are gitignored.

# --- Required ---------------------------------------------------------------

# Your Supabase project's URL: Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable key (sb_publishable_...) from the same page. Safe to expose
# to the browser — every table is guarded by the RLS policies in
# ../supabase/migrations, and the app has no server-side data access at all.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy name for the same thing. Used only if the line above is unset; you
# need one or the other, not both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Branding and locale (optional) -----------------------------------------

# Organisation name, shown in the page title and station headers.
# "Bluebird Cafe" renders as "Bluebird Cafe POS" / "Bluebird Cafe Terminal".
# Default: Kitchen
# NEXT_PUBLIC_ORG_NAME=Bluebird Cafe

# BCP 47 locale for prices, dates, and clock times — this is what decides
# "$4.50" vs "4,50 €" and 2:05 PM vs 14:05.
# Default: en-US
# NEXT_PUBLIC_LOCALE=en-GB

# ISO 4217 currency code (USD, EUR, GBP, JPY, ...). An unrecognised code logs
# a warning and falls back to USD rather than breaking the app.
# Default: USD
# NEXT_PUBLIC_CURRENCY=GBP

# --- Migrations and admin work (optional) -----------------------------------
#
# Server-side only, never sent to the browser, and never needed to run the app
# — the UI is entirely client-side against the publishable key. Add one only
# for migrations, backfills, or scripts that must bypass RLS. Get it from
# Dashboard → Project Settings → API keys → reveal the secret key.
#
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=
