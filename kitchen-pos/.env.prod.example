# Production environment — points the app at the real Supabase project.
# Copy this file to .env.prod and fill in real values. .env.prod is
# gitignored; it holds real credentials and should never be committed.
#
# Used via: make dev-prod / build-prod / start-prod

NEXT_PUBLIC_ORG_NAME=Mint Manor

NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co

# New Supabase key format (sb_publishable_...). Falls back to
# NEXT_PUBLIC_SUPABASE_ANON_KEY if this is unset.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (never exposed to the browser). Optional — only needed
# for admin operations. New format (sb_secret_...) falls back to
# SUPABASE_SERVICE_ROLE_KEY if this is unset.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=
